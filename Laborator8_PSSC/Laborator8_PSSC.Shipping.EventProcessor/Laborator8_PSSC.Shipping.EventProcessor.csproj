<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Shipping worker: listens to the order-placed topic (shipping subscription) and starts the delivery through the delivery API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Laborator8_PSSC.Contracts\Laborator8_PSSC.Contracts.csproj" />
    <ProjectReference Include="..\Laborator8_PSSC.Events.ServiceBus\Laborator8_PSSC.Events.ServiceBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk (unlike Microsoft.NET.Sdk.Web) does not copy appsettings*.json on its own. -->
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
